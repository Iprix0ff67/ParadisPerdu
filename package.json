{
  "name": "paradis-perdu-launcher",
  "version": "1.0.0",
  "description": "Launcher Paradis Perdu pour SCUM",
  "main": "main.js",
  "author": "Paradis Perdu",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.paradisperdu.launcher",
    "productName": "Paradis Perdu Launcher",
    "files": ["main.js", "preload.js", "config.json", "lib/**", "renderer/**", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "portable", "icon": "build/icon.png" },
    "portable": { "artifactName": "ParadisPerdu-Launcher.exe" }
  }
}
